# ============================================================
# ClothInspect-Agent 环境配置示例
# 用法：复制本文件为 .env，按需填写，然后启动后端。
#       所有项都是可选的——不填也能启动（会自动降级）。
# ============================================================

# ---------- 多模态大模型复核（关键项） ----------
# 阿里云百炼 DashScope 的 API Key，用于调用 qwen3-vl-plus 做疑难样本复核。
# 不填时系统自动降级为「离线启发式复核」，界面会明确标注，
# 全部流程仍可演示，但结果不代表论文结论。
DASHSCOPE_API_KEY=

# 复核模式：auto（有 key 走真实，无 key 自动降级）/ real（强制真实）/ heuristic（强制离线）
VLM_MODE=auto

# 复核模型（默认 qwen3-vl-plus，即论文第一周探针选定的模型）
VLM_MODEL=qwen3-vl-plus

# 兼容 OpenAI 协议的自定义端点（换成其他厂商 VLM 时修改这里）
VLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 单次复核超时（秒）
VLM_TIMEOUT=60

# ---------- 模型权重 ----------
# 留空则自动搜索：../模型权重/Final_Model_V6_best.pt → backend/assets/weights/*.pt
YOLO_WEIGHTS=

# 推理设备：0 = 第一块 GPU，cpu = 纯 CPU
YOLO_DEVICE=0

# 推理输入尺寸
IMG_SIZE=640

# ---------- 算法超参（与论文一致，一般无需修改） ----------
# 路由阈值 T：置信度 >= T 直接接受，< T 转大模型复核（论文推荐 0.6，Pareto 膝点）
ROUTER_THRESHOLD=0.60

# YOLO 推理置信度下限
INFER_CONF=0.25

# 仅 YOLO 对照基线阈值（论文口径 0.40）
BASELINE_CONF=0.40

# 局部裁剪外扩比例与最小边长
CROP_MARGIN=0.30
MIN_CROP=96

# ---------- 样例图库 ----------
# 留空则自动搜索 ../实验数据/relabeled_test/images
SAMPLE_DIR=

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8000
